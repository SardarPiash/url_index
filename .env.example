DATABASE_URL=postgresql://indexer:indexer_local@127.0.0.1:54329/indexer_lab

# Optional Google adapter only. These values do not enable themselves.
# Export them in your shell; this project does not auto-load .env.
# Keep service-account keys outside this repository, owned by you, mode 600.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
# GOOGLE_INDEXING_PROPERTY=sc-domain:your-domain.com
# GOOGLE_INDEXING_AUTHORIZED=true
# GOOGLE_INDEXING_ELIGIBLE_PAGES='[{"url":"https://your-domain.com/jobs/42","pageType":"JobPosting"}]'
# For a genuine livestream with BroadcastEvent nested in VideoObject:
# pageType must be "VideoObject/BroadcastEvent" (not a generic video).

# Optional read-only URL Inspection and manual Request Indexing workflow:
# Enable Search Console API and grant this identity access to the verified property.
# SEARCH_CONSOLE_AUTHORIZED=true
# SEARCH_CONSOLE_PROPERTY=sc-domain:beautyhallbd.com
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json

# Live redirect gateway: configure on BOTH the lab and gateway host.
# GATEWAY_AUTHORIZED=true
# GATEWAY_PUBLIC_ORIGIN=https://your-owned-gateway.example
# GATEWAY_TARGET_URL=https://beautyhallbd.com/product/ceramide-face-mask-30ml/
# GATEWAY_PATH_PREFIX=/url-lab
# GATEWAY_PROOF_SECRET=<private-random-secret-at-least-32-characters>

# Explicitly authorized WordPress site (application password, never a main account password).
# CMS_AUTHORIZED=true
# CMS_URL=https://your-owned-publishing-site.example/
# CMS_USERNAME=<your-user>
# CMS_APPLICATION_PASSWORD=<private-application-password>
# Optional same-origin native endpoints:
# CMS_FEED_URL=https://your-owned-publishing-site.example/feed/
# CMS_ATOM_URL=https://your-owned-publishing-site.example/feed/atom/
# CMS_SITEMAP_URL=https://your-owned-publishing-site.example/wp-sitemap-posts-post-1.xml

# Blogger: user OAuth token with https://www.googleapis.com/auth/blogger scope.
# BLOGGER_AUTHORIZED=true
# BLOGGER_BLOG_ID=<numeric-owned-blog-id>
# BLOGGER_PUBLIC_ORIGIN=https://your-owned-blog.blogspot.com
# BLOGGER_ACCESS_TOKEN=<private-user-oauth-token>

# PageSpeed: optional own-project key; anonymous usage may receive HTTP 429.
# PAGESPEED_API_KEY=<private-api-key>
# Optional existing authorized sources used by experiment-suite:
# DISCOVERY_SITEMAP_URL=https://beautyhallbd.com/actual-sitemap.xml
# DISCOVERY_INTERNAL_LINK_URL=https://beautyhallbd.com/actual-source-page/
# DISCOVERY_FEED_URL=https://beautyhallbd.com/actual-feed/
# DISCOVERY_REDIRECT_URL=https://beautyhallbd.com/your-authorized-redirect/
# CRAWL_LOG_FILE=/absolute/path/to/trusted-server-logs.jsonl
